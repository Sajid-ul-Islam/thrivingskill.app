{
  "name": "thrivingskill.app",
  "version": "1.4.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" App.tsx index.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" App.tsx index.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:php": "backend-plugin\\vendor\\bin\\phpunit -c backend-plugin/phpunit.xml.dist",
    "test:structural": "node scripts/run_all_tests.js",
    "test:staging": "node scripts/test_layer2_staging_integration.js",
    "test:e2e:journey": "node scripts/test_layer2_staging_integration.js --journey",
    "version:check": "node scripts/sync_version.js --check",
    "version:sync": "node scripts/sync_version.js --write",
    "test:ci": "npm run version:check && npm run typecheck && npm run audit && npm run test:coverage && npm run test:structural",
    "audit": "node scripts/audit_app.js",
    "build:dry-run": "npx expo export --dump-sourcemap=false",
    "build:apk": "npx expo prebuild --platform android --no-install && cd android && gradlew.bat assembleRelease",
    "build:apk:local": "expo run:android --variant release",
    "build:eas:local": "eas build --platform android --profile production --local",
    "build:preview": "eas build --profile preview --platform android",
    "build:prod": "eas build --profile production --platform android",
    "build:prod:apk": "eas build --profile production-apk --platform android",
    "update:prod": "eas update --channel production",
    "update:eas": "eas update --channel production",
    "export:self-hosted": "npx expo export"
  },
  "dependencies": {
    "@expo/metro-runtime": "58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.22.0",
    "@react-navigation/native": "^7.5.2",
    "@react-navigation/native-stack": "^7.21.1",
    "@sentry/react-native": "~8.28.0",
    "expo": "^58.0.0",
    "expo-build-properties": "~58.0.12",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-video": "~58.0.14",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-web-webview": "^1.0.2",
    "react-native-webview": "14.0.1",
    "react-native-youtube-iframe": "^2.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^21.0.0",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
