{
  "expo": {
    "name": "Thriving Skills",
    "slug": "thrivingskillapp",
    "version": "1.4.0",
    "scheme": "thrivingskill",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.thrivingskill.app",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:thrivingskill.com",
        "applinks:www.thrivingskill.com"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.thrivingskill.app",
      "versionCode": 10400,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#102F53",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "thrivingskill.com",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "www.thrivingskill.com",
              "pathPrefix": "/login"
            },
            {
              "scheme": "https",
              "host": "thrivingskill.com",
              "pathPrefix": "/courses"
            },
            {
              "scheme": "https",
              "host": "www.thrivingskill.com",
              "pathPrefix": "/courses"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#102F53",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#102F53"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "0b66cee6-c1a5-4c67-b12a-08f8f4356787"
      }
    },
    "owner": "sajid.islam",
    "runtimeVersion": "1.4.0",
    "updates": {
      "url": "https://u.expo.dev/0b66cee6-c1a5-4c67-b12a-08f8f4356787",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
