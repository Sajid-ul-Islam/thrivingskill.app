{
  "cli": {
    "version": ">= 3.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.thrivingskill.com/wp-json",
        "EXPO_PUBLIC_SITE_URL": "https://staging.thrivingskill.com",
        "EXPO_PUBLIC_WP_ADMIN_URL": "https://staging.thrivingskill.com/wp-admin/",
        "EXPO_PUBLIC_DEFAULT_ENVIRONMENT": "staging"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.thrivingskill.com/wp-json",
        "EXPO_PUBLIC_SITE_URL": "https://staging.thrivingskill.com",
        "EXPO_PUBLIC_WP_ADMIN_URL": "https://staging.thrivingskill.com/wp-admin/",
        "EXPO_PUBLIC_DEFAULT_ENVIRONMENT": "staging"
      }
    },
    "preview-device": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://staging.thrivingskill.com/wp-json",
        "EXPO_PUBLIC_SITE_URL": "https://staging.thrivingskill.com",
        "EXPO_PUBLIC_WP_ADMIN_URL": "https://staging.thrivingskill.com/wp-admin/",
        "EXPO_PUBLIC_DEFAULT_ENVIRONMENT": "staging"
      }
    },
    "production": {
      "channel": "production",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://thrivingskill.com/wp-json",
        "EXPO_PUBLIC_SITE_URL": "https://thrivingskill.com",
        "EXPO_PUBLIC_WP_ADMIN_URL": "https://thrivingskill.com/wp-admin/",
        "EXPO_PUBLIC_DEFAULT_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
