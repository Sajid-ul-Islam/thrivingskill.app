# ==============================================================================
# Thriving Skills (TSL) Mobile App — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local (for local overrides) or use .env.development / .env.production.
# 2. Populate all required keys. Expo inlines static `process.env.EXPO_PUBLIC_*`
#    references at bundle time.
# 3. NEVER put secret API keys (e.g. AI/LLM provider keys or WooCommerce secrets)
#    in EXPO_PUBLIC_* variables — proxy privileged calls through the backend API.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Endpoints (Required)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_API_URL=https://staging.thrivingskill.com/wp-json
EXPO_PUBLIC_SITE_URL=https://staging.thrivingskill.com
EXPO_PUBLIC_WP_ADMIN_URL=https://staging.thrivingskill.com/wp-admin/
EXPO_PUBLIC_DEFAULT_ENVIRONMENT=staging

# Optional dedicated production mirror URL (never point to staging in production)
# EXPO_PUBLIC_FALLBACK_API_URL=
# EXPO_PUBLIC_FALLBACK_SITE_URL=

# ------------------------------------------------------------------------------
# 2. Network & Performance Configuration
# ------------------------------------------------------------------------------
# Request timeout in milliseconds (default: 15000 = 15 seconds)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Maximum automatic retries on transient network errors (default: 2)
EXPO_PUBLIC_MAX_RETRIES=2

# In-memory API cache Time-To-Live in milliseconds (default: 300000 = 5 minutes)
EXPO_PUBLIC_CACHE_TTL_MS=300000

# Fallback to offline seed cache / mirror if network fails (true/false, default: true)
EXPO_PUBLIC_ENABLE_FALLBACK=true

# Detailed API request/response logging in console (true/false, default: true in dev)
EXPO_PUBLIC_DEBUG_API=false
