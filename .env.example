# ==============================================================================
# Thriving Skills Mobile App Environment Configuration
# Copy this file to .env or .env.local to configure your custom environment:
#   cp .env.example .env
#
# Note: In Expo SDK 49+, all client-accessible environment variables MUST start
# with EXPO_PUBLIC_ prefix.
# ==============================================================================

# Primary WordPress Backend REST API Base URL
# Default: https://thrivingskill.com/wp-json
EXPO_PUBLIC_API_URL=https://thrivingskill.com/wp-json

# Main Website URL
EXPO_PUBLIC_SITE_URL=https://thrivingskill.com

# HTTP Request Timeout in milliseconds (default: 15000 = 15 seconds)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Number of automatic retries on network failures (default: 2)
EXPO_PUBLIC_MAX_RETRIES=2

# Cache TTL in milliseconds for catalog data (default: 300000 = 5 minutes)
EXPO_PUBLIC_CACHE_TTL_MS=300000

# Enable offline mock data fallback when network is unavailable (true/false)
EXPO_PUBLIC_ENABLE_FALLBACK=true

# Debug Logging (true/false) - logs API requests and responses in development
EXPO_PUBLIC_DEBUG_API=false

# Optional: WooCommerce API keys (if using authenticated store endpoints)
# EXPO_PUBLIC_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxx
# EXPO_PUBLIC_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxx
