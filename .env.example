# ==============================================================================
# Thriving Skills (TSL) Mobile App — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env in your root directory:
#    cp .env.example .env
# 2. Populate the required keys with your staging or production values.
# 3. DO NOT commit your .env file to Git (it is ignored by .gitignore).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend REST API Endpoints
# ------------------------------------------------------------------------------
# Base WordPress REST API URL (defaults to https://thrivingskill.com/wp-json if omitted)
EXPO_PUBLIC_API_URL=https://thrivingskill.com/wp-json

# Main Website URL
EXPO_PUBLIC_SITE_URL=https://thrivingskill.com

# ------------------------------------------------------------------------------
# 2. Network & Performance Configuration
# ------------------------------------------------------------------------------
# Request timeout in milliseconds (default: 15000 = 15 seconds)
EXPO_PUBLIC_REQUEST_TIMEOUT_MS=15000

# Maximum automatic retries on transient network errors (default: 2)
EXPO_PUBLIC_MAX_RETRIES=2

# In-memory API cache Time-To-Live in milliseconds (default: 300000 = 5 minutes)
EXPO_PUBLIC_CACHE_TTL_MS=300000

# Fallback to offline seed database if network fails (true/false, default: true)
EXPO_PUBLIC_ENABLE_FALLBACK=true

# Detailed API request/response logging in console (true/false, default: true in dev)
EXPO_PUBLIC_DEBUG_API=false

# ------------------------------------------------------------------------------
# 3. AI Mentor Integration (Google Gemini)
# ------------------------------------------------------------------------------
# Google Gemini 2.5 Flash API Key for AI Career Mentor & Prompt Blueprints
# Get your API key from Google AI Studio: https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=

# Alternative fallback key name
EXPO_PUBLIC_GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# 4. WooCommerce / LMS Authentication (Optional)
# ------------------------------------------------------------------------------
# Consumer key and secret for direct WooCommerce / LearnPress admin actions
EXPO_PUBLIC_WC_CONSUMER_KEY=
EXPO_PUBLIC_WC_CONSUMER_SECRET=
